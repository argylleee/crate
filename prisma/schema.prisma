generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Performer {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  category      String
  genre         String
  genres        String[]
  startingPrice Int
  location      String
  profilePhoto  String
  coverImage    String
  bio           String    @db.Text
  gallery       String[]
  rating        Float     @default(0)
  reviewCount   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings      Booking[]
  favorites     Favorite[]
  pricingTiers  PricingTier[]

  @@map("performers")
}

model PricingTier {
  id          String    @id @default(cuid())
  label       String
  hours       Int
  price       Int
  createdAt   DateTime  @default(now())

  performerId String
  performer   Performer @relation(fields: [performerId], references: [id], onDelete: Cascade)

  @@map("pricing_tiers")
}

model Booking {
  id            String    @id @default(cuid())
  eventDate     DateTime
  eventTime     String
  eventLocation String
  eventType     String
  notes         String?
  createdAt     DateTime  @default(now())

  performerId   String
  performer     Performer @relation(fields: [performerId], references: [id])

  userId        String?
  user          User?     @relation(fields: [userId], references: [id])

  @@map("bookings")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  createdAt     DateTime  @default(now())

  bookings      Booking[]
  favorites     Favorite[]

  @@map("users")
}

model Favorite {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())

  userId        String
  user          User      @relation(fields: [userId], references: [id])

  performerId   String
  performer     Performer @relation(fields: [performerId], references: [id])

  @@unique([userId, performerId])
  @@map("favorites")
}
